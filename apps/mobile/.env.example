# Supabase (public -- safe to ship in the app bundle; this is the ANON/publishable key, not the
# service-role key, which must NEVER exist in this app).
# Same project as apps/web -- copy the values from apps/web/.env.local.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# apps/worker's HTTP entry point. Only used for endpoints that are safe to call with just the
# caller's own bearer token (no shared secret) -- see src/lib/core/worker/client.ts. Do NOT put
# WORKER_INTERNAL_SECRET here or anywhere in this app: it is a shared server-to-server secret and
# this bundle ships to app stores where it can be extracted.
# Dev default assumes an Android emulator reaching the host machine; a physical device on the same
# Wi-Fi needs the machine's LAN IP instead of localhost/10.0.2.2.
EXPO_PUBLIC_WORKER_URL=http://10.0.2.2:8787
