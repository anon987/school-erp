# Supabase (public -- safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never put SUPABASE_SERVICE_ROLE_KEY in this app. It belongs only in apps/worker/.env.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# apps/worker's HTTP entry point (P1 -- /settings/members). Server-only, never NEXT_PUBLIC_ --
# this is called from Server Actions, never the browser. WORKER_INTERNAL_SECRET must match
# apps/worker's WORKER_INTERNAL_SECRET exactly.
WORKER_URL=http://localhost:8787
WORKER_INTERNAL_SECRET=

# Razorpay (P1 -- Fees online collection). Server-only. Order creation only -- webhook
# verification uses apps/worker's own RAZORPAY_WEBHOOK_SECRET, not this file's.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
