# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# This key must exist ONLY here and in this file's real .env counterpart -- never in
# apps/web, never in a client bundle, never committed. See CLAUDE.md's isolation rules.

# HTTP entry point (P1 -- /settings/members). Not publicly exposed; called only by apps/web's
# Server Actions over the internal network. WORKER_INTERNAL_SECRET must match apps/web's
# WORKER_INTERNAL_SECRET exactly -- generate a random 32+ char value, never reuse across
# environments, never commit the real value.
PORT=8787
WORKER_INTERNAL_SECRET=

# Razorpay (P1 -- Fees online collection). Webhook verification only -- order creation happens
# in apps/web with its own RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET, not this file's. Optional: the
# worker still boots without it, but POST /webhooks/razorpay returns 503 until it's set.
RAZORPAY_WEBHOOK_SECRET=

# Parent Portal (P2). Same value as apps/web's NEXT_PUBLIC_APP_URL.
APP_URL=http://localhost:3000

# Communication (P2). All optional -- omit any of these and that channel's notifications fail
# with a clear "provider not configured" error instead of crashing the dispatch run. None of
# these three providers are exercised end-to-end anywhere in this codebase.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
GUPSHUP_API_KEY=
GUPSHUP_SOURCE_NUMBER=
GUPSHUP_APP_NAME=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
